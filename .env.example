# Copy to `.env` for running the API outside Docker (`cp .env.example .env`).

LOG_LEVEL=INFO
# `json` (default) for log shippers, `text` for a readable local terminal.
LOG_FORMAT=text
DATABASE_URL=postgresql+asyncpg://podcasts:podcasts@localhost:5432/podcasts

# Static client credentials exchanged at POST /auth/token (required).
AUTH_CLIENT_ID=reviewer
AUTH_CLIENT_SECRET=local-dev-secret-change-me
# HS256 signing key, at least 32 characters (required).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=local-dev-jwt-secret-change-me-0123456789
JWT_TTL_SECONDS=3600
